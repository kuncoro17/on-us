{
  "name": "wff-wilayah-family-fest",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "build:admin": "vite build --config vite.admin.config.mjs",
    "build:web": "vite build --config vite.web.config.mjs",
    "build": "npm run build:web && npm run build:admin",
    "migrate": "node --env-file=.env scripts/migrate.js",
    "dev": "npm run build && node --env-file=.env server.js",
    "start": "node server.js",
    "admin:dev": "vite --config vite.admin.config.mjs"
  },
  "dependencies": {
    "express": "^5.1.0",
    "multer": "^2.0.2",
    "pg": "^8.16.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "vite": "^8.3.4"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.2"
  }
}
